DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_CONNECTION_LIMIT=10

JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=12h
CORS_ORIGIN=*

