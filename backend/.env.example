PORT=4000
NODE_ENV=development

# Option 1 (Recommended for deployment — Aiven, Railway, TiDB, RDS):
# DATABASE_URL=mysql://user:password@host:3306/cognix_db

# Option 2 (Discrete MySQL credentials):
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
